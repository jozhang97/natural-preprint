{
  "name": "paper-reformatter",
  "version": "1.0.0",
  "description": "Private, browser-based preprint PDF reformatter for GitHub Pages",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:analytics": "node --test scripts/analytics.test.mjs",
    "test:ui": "playwright test --ui",
    "make:demo": "node scripts/make-demo.mjs",
    "predev": "node scripts/prepare-pdfjs.mjs",
    "prebuild": "node scripts/prepare-pdfjs.mjs"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module"
}
